# Copy this file to .env (same folder) and fill in ONE key.
# The server picks the provider from whichever key is set.

# Cheapest good option:
# DEEPSEEK_API_KEY=sk-...

# Fast + has a free tier:
# GROQ_API_KEY=gsk_...

# Best quality:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: override the default model for your provider
# MODEL=

# Any OpenAI-compatible server (Ollama, LM Studio, OpenRouter, vLLM…):
# PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# MODEL=llama3.1
# LLM_API_KEY=

# Optional
# PORT=8787
